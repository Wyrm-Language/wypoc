# Buffered file IO over the __open/__read/__write/__lseek/__close/__flush
# primitives the interpreter exposes (wypoc: wypoc/wyrm_io.py; the C
# interpreter in ../wyrm-vibe: src/lang/builtins.c). Handles are small
# integers, POSIX-style, with __STDIN/__STDOUT/__STDERR pre-bound.
#
# Written in the subset both interpreters accept, so the same file backs
# either one: no default parameter values, and slots are reached through an
# explicit `this.`.

newline := "\n"

fn println(*content):
    first := true
    for arg in content:
        if not first:
            __write(__STDOUT, " ")
        first = false
        __write(__STDOUT, str(arg))
    __write(__STDOUT, "\n")
    # explicit, now that a fn's implicit return is the value of its last
    # statement: without this, println would answer __write's byte count
    # instead of nil - it's I/O, not string-building. `pass`, not
    # `return nil`, to match this value's own two-spellings-of-nil note
    # (wyrm_builtins._format): a fallen-off-the-end fn already answers nil
    # this way, with no second spelling to reconcile against `is None`.
    pass

fn eprintln(*content):
    first := true
    for arg in content:
        if not first:
            __write(__STDERR, " ")
        first = false
        __write(__STDERR, str(arg))
    __write(__STDERR, "\n")
    pass

class File:
    slot handle: int = -1

    fn read(size) -> str:
        return __read(this.handle, size)

    fn readall() -> str:
        return __read(this.handle, -1)

    # For a handle opened in binary mode ("rb", ...): __read then answers a
    # Python bytes object rather than a str, and bytes(...) copies it into a
    # real wyrm bytes value (see doc/stdlib.md's `### bytes`).
    fn read_bytes(size) -> bytes:
        return bytes(__read(this.handle, size))

    # `data` may be a str or a bytes value - __write just hands it to the
    # underlying handle's own write(), so this matches whichever mode the
    # handle was opened in ("w"/"a" for str, "wb"/"ab" for bytes).
    fn write(data) -> int:
        return __write(this.handle, data)

    fn seek(offset, whence) -> int:
        return __lseek(this.handle, offset, whence)

    fn tell() -> int:
        return __lseek(this.handle, 0, 1)

    fn flush() -> int:
        return __flush(this.handle)

    fn close() -> int:
        return __close(this.handle)

# `mode` is an open()-style mode string ("r", "w", "a", "rb", ...), not
# POSIX O_* flags. The handle is an error value when the open fails, so
# `f := try open(path, "r")` propagates it.
fn open(path, mode) -> File:
    f := File()
    f.handle = try __open(path, mode)
    return f

fn read_file(path) -> str:
    f := try open(path, "r")
    defer:
        f!close()
    return f!readall()

fn write_file(path, data) -> int:
    f := try open(path, "w")
    defer:
        f!close()
    return f!write(data)

# Binary-mode counterpart to write_file, for a bytes value (epic 7). A
# separate top-level function, not just "pass 'wb'  to write_file", because
# `!write` is an INSTANCE message: sending it to a File built and returned
# from *this* module works (write_file already does exactly this), but the
# same message send from an external caller holding the returned File can
# fail to resolve depending on the caller's own module - calling through a
# function defined here, in File's own module, sidesteps that entirely.
fn write_bytes_file(path, data) -> int:
    f := try open(path, "wb")
    defer:
        f!close()
    return f!write(data)
