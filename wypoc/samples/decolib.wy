# Decorators, written in wyrm, for samples/decorators.wy.
#
# A decorator is a message on TreeBase: it receives the tree of whatever it
# decorates and answers the tree to compile instead. A decorator name is a
# bare selector, never a path, so the importing module can call one from here
# once this module's messages are in its own message table - `import
# decolib::*` puts them there.
#
# `sexpr(x)` is the canonical tree (see wypoc/sexpr.py's module docstring
# for the format): pair lists throughout, `(head field ...)`.

import std::io::*

fn nth(node, n) -> TreeBase:
    i := 0
    while i < n:
        node = cdr(node)
        i = i + 1
    return car(node)

# A `fn_def` node is (fn_def name dispatch params ret body).
_FN_PARAMS := 3
_FN_BODY := 5

fn rebuild_fn(s, body):
    return $['fn_def, nth(s, 1), nth(s, 2), nth(s, 3), nth(s, 4), body]

# An array as a pair list - trees are made of pair lists only.
fn pairs(arr):
    out := nil
    i := len(arr) - 1
    while i >= 0:
        out = cons(arr[i], out)
        i = i - 1
    return out

# A body is one form: the statement itself, or (do s ...) for several.
# These two convert between that and an array of statements.
fn statements(body) -> list:
    out := []
    if body is pair and car(body) == 'do:
        for stmt in cdr(body):
            out ! append(stmt)
    else:
        out ! append(body)
    return out

fn as_body(stmts):
    if len(stmts) == 1:
        return stmts[0]
    return cons('do, pairs(stmts))

# Answers what it was given, still boxed - the other half of the return
# contract, which takes a tree or a TreeBase.
fn [TreeBase] unchanged():
    return this

# Prepends a `println` to a definition's body.
fn [TreeBase] traced(label):
    s := sexpr(this)
    out := [$['apply, 'println, $['str, label]]]
    for stmt in statements(nth(s, _FN_BODY)):
        out ! append(stmt)
    return rebuild_fn(s, as_body(out))

# Replaces a definition's body outright, ignoring what was written.
fn [TreeBase] constant(value):
    return rebuild_fn(sexpr(this), $['return, $['int, value]])

# An expression decorator: `@scaled(3) x` becomes `x * 3`.
fn [TreeBase] scaled(factor):
    return $['*, sexpr(this), $['int, factor]]

# Reads the signature it was handed rather than rewriting it: answers a
# function returning its own parameter count.
fn [TreeBase] arity():
    s := sexpr(this)
    n := len(nth(s, _FN_PARAMS))
    return rebuild_fn(s, $['return, $['int, n]])

# A type is (type member ...): a member is a bare name symbol, or a path
# (:: seg ... name) when qualified - the name is the member itself in the
# first case, its last segment in the second. No annotation is (type auto).
fn type_name(ty) -> TreeBase:
    x := nth(ty, 1)
    if x is sym:
        return x
    segs := cdr(x)
    while cdr(segs) != nil:
        segs = cdr(segs)
    return car(segs)

# Reads the *types* in a signature. Types are carried by the tree and
# enforced by nothing, which is exactly what makes them a decorator's to
# read: this one answers the declared parameter type names as an array. A
# parameter is (name type default).
fn [TreeBase] param_types():
    s := sexpr(this)
    out := []
    for param in nth(s, _FN_PARAMS):
        name := type_name(nth(param, 1))
        if name == 'auto:
            out ! append($['str, "?"])
        else:
            out ! append($['str, str(name)])
    return rebuild_fn(s, $['return, cons('array, pairs(out))])

# --- templates ------------------------------------------------------------
#
# A template is an ordinary function. `name::$ast` is its tree, so the
# pattern is written in wyrm rather than assembled node by node, and `...`
# marks where the decorated body goes.

fn is_hole(stmt) -> bool:
    return stmt is pair and car(stmt) == 'ellipsis

# Splices `body` (an array of statements) into `template` at its `...`.
fn expand_template(template, body) -> list:
    out := []
    for stmt in statements(nth(sexpr(template), _FN_BODY)):
        if is_hole(stmt):
            for inner in body:
                out ! append(inner)
        else:
            out ! append(stmt)
    return as_body(out)

# Anything after the hole is only reached if the body falls off the end - a
# spliced `return` leaves it unreachable, exactly as writing it out would.
# `defer` is how a template runs something on the way out regardless.
fn _framed():
    defer:
        println("template: leaving")
    println("template: entering")
    ...

fn [TreeBase] framed():
    s := sexpr(this)
    return rebuild_fn(s, expand_template(_framed::$ast, statements(nth(s, _FN_BODY))))

# The same, with the template named by the caller: a `$ast` is as available
# at decoration time as a literal is, so it can be a decorator argument.
fn [TreeBase] using_template(template):
    s := sexpr(this)
    return rebuild_fn(s, expand_template(template, statements(nth(s, _FN_BODY))))

# --- the `__sexpr` hook ---------------------------------------------------
#
# `sexpr(x)` asks a class before it does anything else, so a class can say
# what its own s-expression is. That is what lets one decorator source serve
# both worlds: here a tree already *is* an s-expression once unboxed, while
# against a class-based tree each node converts itself.

class Literal:
    slot n: int = 0

    fn init(n: int):
        this.n = n

    fn __sexpr():
        return $['int, this.n]

# The hook may also be given from outside the class body, which is the
# message-table path rather than a class-body method, and it is inherited.
class Boxed:
    slot n: int = 0

    fn init(n: int):
        this.n = n

class SubBoxed(Boxed) {}

fn [Boxed] __sexpr():
    return $['int, this.n * 2]

# A decorator may answer such an object: the return contract normalizes
# whatever comes back exactly as `sexpr()` would.
fn [TreeBase] as_literal(value):
    return Literal(value)
